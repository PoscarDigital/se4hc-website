---
import { useTranslations, type Lang } from '../../utils/i18n';
import HeroSection from '../sections/HeroSection.astro';
import GallerySection from '../sections/GallerySection.astro';
import VideoSection from '../sections/VideoSection.astro';
import StatsGrid from '../sections/StatsGrid.astro';
import QuickLinks from '../sections/QuickLinks.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const overview = [
  { title: t('home.infraTitle'), text: t('home.infraText') },
  { title: t('home.capacityTitle'), text: t('home.capacityText') },
  { title: t('home.systemTitle'), text: t('home.systemText') },
];
---

<HeroSection lang={lang} />

<GallerySection lang={lang} />

<section class="py-16">
  <div class="container">
    <div class="bg-white rounded-2xl shadow-lg p-8 md:p-10 mb-12">
      <h3 class="section-title">{t('home.overviewTitle')}</h3>
      <p class="text-center text-gray-600 max-w-3xl mx-auto mb-4">{t('home.overviewIntro')}</p>
      <p class="text-center text-gray-600 max-w-3xl mx-auto mb-10">{t('home.overviewFinancing')}</p>
      <StatsGrid lang={lang} />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {overview.map((item) => (
        <div class="text-center px-4">
          <h4 class="text-xl text-primary font-bold mb-3">{item.title}</h4>
          <p class="text-gray-600">{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<VideoSection lang={lang} />

<QuickLinks lang={lang} />
