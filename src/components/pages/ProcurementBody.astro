---
import { getCollection } from 'astro:content';
import { useTranslations, type Lang } from '../../utils/i18n';
import { localize } from '../../utils/helpers';
import ProcurementCard from '../cards/ProcurementCard.astro';
import pageContent from '../../data/page-content.json';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const proc = pageContent.procurement;

const awards = (await getCollection('procurement', (e) => e.data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<div class="space-y-14">
  <!-- Overview stats -->
  <section>
    <h2 class="text-2xl font-bold text-primary mb-6">{t('procurement.overview')}</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {proc.overviewStats.map((stat) => (
        <div class="text-center bg-white rounded-xl shadow-sm p-5">
          <p class="text-2xl font-bold text-primary">{stat.value}</p>
          {stat.note && <p class="text-accent text-xs font-semibold">{stat.note}</p>}
          <p class="text-gray-500 text-sm mt-1">{localize(stat.label, lang)}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Categories -->
  <section>
    <h2 class="text-2xl font-bold text-primary mb-6">{t('procurement.categories')}</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {proc.categories.map((cat) => (
        <div class="card">
          <h3 class="text-lg font-bold text-secondary mb-2">{localize(cat.title, lang)}</h3>
          <p class="text-gray-600 text-sm mb-4">{localize(cat.description, lang)}</p>
          <ul class="list-disc pl-5 text-gray-700 text-sm space-y-1">
            {cat.items[lang].map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Process -->
  <section class="bg-background rounded-2xl p-8">
    <h2 class="text-2xl font-bold text-primary mb-6">{t('procurement.process')}</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {proc.process.map((step) => (
        <div class="text-center">
          <span class="inline-flex w-12 h-12 rounded-full bg-primary text-white items-center justify-center font-bold text-lg mb-3">
            {step.step}
          </span>
          <h3 class="font-bold text-primary mb-1">{localize(step.title, lang)}</h3>
          <p class="text-gray-600 text-sm">{localize(step.description, lang)}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Contract Awards -->
  <section>
    <h2 class="text-2xl font-bold text-primary mb-6">{t('procurement.awards')}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {awards.map((item) => <ProcurementCard item={item} lang={lang} />)}
    </div>
  </section>
</div>
