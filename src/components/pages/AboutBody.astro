---
import { useTranslations, type Lang } from '../../utils/i18n';
import { formatMillions, formatDate, localize } from '../../utils/helpers';
import StatsGrid from '../sections/StatsGrid.astro';
import siteData from '../../data/site.json';
import stats from '../../data/project-stats.json';
import partners from '../../data/partners.json';
import pageContent from '../../data/page-content.json';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const about = pageContent.about;

const components = [
  { title: t('about.infraDev'), items: about.components.infrastructure[lang] },
  { title: t('about.capacityDev'), items: about.components.capacity[lang] },
  { title: t('about.inclusiveEducation'), items: about.components.inclusive[lang] },
];

const admin = [
  { label: t('stats.adbLoan'), value: `Loan No. ${siteData.loanNumber}` },
  { label: t('stats.loanEffective'), value: formatDate(siteData.loanEffectiveDate, lang) },
  { label: t('stats.projectClosing'), value: formatDate(siteData.projectClosingDate, lang) },
  { label: t('stats.implementationPeriod'), value: `${siteData.implementationPeriod} ${lang === 'km' ? 'ឆ្នាំ' : 'Years'}` },
];
---

<div class="space-y-14">
  <!-- Overview -->
  <section>
    <h2 class="text-2xl font-bold text-primary mb-4">{t('about.overview')}</h2>
    <p class="text-gray-700 mb-8">{t('about.overviewText')}</p>
    <StatsGrid lang={lang} />
  </section>

  <!-- Rationale -->
  <section class="bg-background rounded-2xl p-8">
    <h2 class="text-2xl font-bold text-primary mb-4">{t('about.rationale')}</h2>
    <p class="text-gray-700 mb-4">{t('about.rationaleText')}</p>
    <p class="text-gray-700 mb-4">{t('about.rationaleText2')}</p>
    <p class="text-gray-700 mb-6">{t('about.rationaleText3')}</p>
    <h3 class="text-lg font-bold text-secondary mb-3">{t('about.approachTitle')}</h3>
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 list-none p-0 m-0">
      {about.rationaleApproach[lang].map((item) => (
        <li class="flex items-start gap-2 text-gray-700">
          <span class="text-accent font-bold">✓</span>{item}
        </li>
      ))}
    </ul>
  </section>

  <!-- Key Components -->
  <section>
    <h2 class="text-2xl font-bold text-primary mb-6">{t('about.components')}</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {components.map((comp) => (
        <div class="card">
          <h3 class="text-lg font-bold text-secondary mb-4">{comp.title}</h3>
          <ul class="space-y-2 list-disc pl-5 text-gray-700 text-sm">
            {comp.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Expected Outcomes -->
  <section>
    <h2 class="text-2xl font-bold text-primary mb-6">{t('about.outcomes')}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {stats.outputs.map((output) => (
        <div class="flex gap-4 items-start bg-white rounded-xl shadow-sm p-5">
          <span class="shrink-0 w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center font-bold">
            {output.id}
          </span>
          <div>
            <h3 class="font-semibold text-primary mb-1">{localize(output.title, lang)}</h3>
            {output.description && <p class="text-gray-600 text-sm">{localize(output.description, lang)}</p>}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Management Structure -->
  <section class="bg-background rounded-2xl p-8">
    <h2 class="text-2xl font-bold text-primary mb-4">{t('about.structure')}</h2>
    <p class="text-gray-700 mb-6">{t('about.structureText')}</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {partners.implementingAgencies.map((agency) => (
        <div class="bg-white rounded-xl p-5 border-l-4 border-secondary">
          <h3 class="font-semibold text-primary mb-1">{localize(agency.name, lang)}</h3>
          <p class="text-gray-600 text-sm">{localize(agency.description, lang)}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Administration -->
  <section>
    <h2 class="text-2xl font-bold text-primary mb-6">{t('about.administration')}</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {admin.map((item) => (
        <div class="text-center bg-white rounded-xl shadow-sm p-5">
          <p class="text-sm text-gray-500 mb-1">{item.label}</p>
          <p class="font-bold text-primary">{item.value}</p>
        </div>
      ))}
    </div>
  </section>
</div>
