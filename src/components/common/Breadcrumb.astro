---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../utils/i18n';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<nav aria-label="Breadcrumb" class="bg-gray-50 border-b border-gray-200">
  <div class="container py-3">
    <ol class="flex flex-wrap items-center gap-2 text-sm list-none m-0 p-0 text-gray-500">
      <li>
        <a href={getLocalizedPath('/', lang)} class="hover:text-primary no-underline">{t('common.home')}</a>
      </li>
      {items.map((item) => (
        <>
          <li aria-hidden="true" class="text-gray-300">/</li>
          <li>
            {item.href ? (
              <a href={getLocalizedPath(item.href, lang)} class="hover:text-primary no-underline">{item.label}</a>
            ) : (
              <span class="text-gray-700 font-medium" aria-current="page">{item.label}</span>
            )}
          </li>
        </>
      ))}
    </ol>
  </div>
</nav>
