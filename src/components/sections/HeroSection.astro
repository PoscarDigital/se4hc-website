---
import { useTranslations, getLocalizedPath, type Lang } from '../../utils/i18n';
import Button from '../ui/Button.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="bg-gradient-to-br from-primary to-secondary text-white py-20 text-center">
  <div class="container">
    <h2 class="text-4xl md:text-5xl font-bold mb-6">{t('home.heroTitle')}</h2>
    <p class="text-lg md:text-xl max-w-3xl mx-auto mb-10 opacity-90">{t('home.heroSubtitle')}</p>
    <Button href={getLocalizedPath('/about', lang)} variant="accent">{t('home.heroCta')}</Button>
  </div>
</section>
