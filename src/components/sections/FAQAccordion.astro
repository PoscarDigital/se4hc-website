---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  faqs: CollectionEntry<'faqs'>[];
}

const { faqs } = Astro.props;
const rendered = await Promise.all(
  faqs.map(async (faq) => ({ faq, Content: (await render(faq)).Content })),
);
---

<div class="space-y-3">
  {rendered.map(({ faq, Content }) => (
    <details class="group bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
      <summary class="flex justify-between items-center cursor-pointer px-6 py-4 font-semibold text-primary list-none">
        <span>{faq.data.title}</span>
        <svg
          class="h-5 w-5 shrink-0 transition-transform group-open:rotate-180"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <div class="px-6 pb-5 prose-content text-gray-700">
        <Content />
      </div>
    </details>
  ))}
</div>
