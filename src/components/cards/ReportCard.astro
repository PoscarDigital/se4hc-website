---
import type { CollectionEntry } from 'astro:content';
import { useTranslations, getLocalizedPath, type Lang } from '../../utils/i18n';
import { formatDate, entrySlug } from '../../utils/helpers';
import Badge from '../ui/Badge.astro';
import FeatureImage from '../media/FeatureImage.astro';

interface Props {
  report: CollectionEntry<'reports'>;
  lang: Lang;
}

const { report, lang } = Astro.props;
const t = useTranslations(lang);
const { title, date, type, pages, status, excerpt, featureImage, featureImageAlt, attachments } = report.data;
const slug = entrySlug(report.id);
const detailHref = getLocalizedPath(`/reports/${slug}`, lang);
const docCount = attachments?.length ?? 0;
---

<article class="card card-hover flex flex-col !p-0 overflow-hidden">
  {featureImage && (
    <a href={detailHref} class="block">
      <FeatureImage src={featureImage} alt={featureImageAlt ?? title} rounded={false} />
    </a>
  )}
  <div class="p-6 flex flex-col flex-grow">
    <div class="flex items-start justify-between gap-3 mb-3">
      {type && (
        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-secondary capitalize">
          {type}
        </span>
      )}
      {status && status !== 'archived' && <Badge variant={status} label={t(`common.${status}`)} />}
    </div>
    <h3 class="text-lg font-bold text-primary mb-2">{title}</h3>
    <p class="text-gray-500 text-xs mb-3">
      {t('common.published')}: {formatDate(date, lang)}
      {pages && <> · {pages} {t('common.pages')}</>}
      {docCount > 0 && <> · {docCount} {lang === 'km' ? 'ឯកសារ' : docCount === 1 ? 'file' : 'files'}</>}
    </p>
    <p class="text-gray-600 text-sm flex-grow mb-4">{excerpt}</p>
    <a href={detailHref} class="text-secondary font-semibold text-sm no-underline hover:text-primary mt-auto w-fit">
      {t('common.viewDetails')} →
    </a>
  </div>
</article>
