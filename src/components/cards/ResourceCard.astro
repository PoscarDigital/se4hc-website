---
import type { CollectionEntry } from 'astro:content';
import { useTranslations, getLocalizedPath, type Lang } from '../../utils/i18n';
import { formatDate, entrySlug } from '../../utils/helpers';
import FeatureImage from '../media/FeatureImage.astro';

interface Props {
  resource: CollectionEntry<'resources'>;
  lang: Lang;
}

const { resource, lang } = Astro.props;
const t = useTranslations(lang);
const { title, type, date, excerpt, featureImage, featureImageAlt, attachments } = resource.data;
const slug = entrySlug(resource.id);
const detailHref = getLocalizedPath(`/resources/${slug}`, lang);

// Derive a short format hint from the attached files' extensions.
const exts = [...new Set((attachments ?? []).map((a) => (a.file.match(/\.([a-z0-9]+)$/i)?.[1] ?? '').toUpperCase()).filter(Boolean))];
const formatHint = exts.join(', ');
---

<article class="card card-hover flex flex-col !p-0 overflow-hidden">
  {featureImage && (
    <a href={detailHref} class="block">
      <FeatureImage src={featureImage} alt={featureImageAlt ?? title} rounded={false} />
    </a>
  )}
  <div class="p-6 flex flex-col flex-grow">
    {type && (
      <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 mb-3 w-fit">
        {type}
      </span>
    )}
    <h3 class="text-lg font-bold text-primary mb-2">{title}</h3>
    <p class="text-gray-500 text-xs mb-3">
      {t('common.updated')}: {formatDate(date, lang)}
      {formatHint && <> · {formatHint}</>}
    </p>
    <p class="text-gray-600 text-sm flex-grow mb-4">{excerpt}</p>
    <a href={detailHref} class="text-secondary font-semibold text-sm no-underline hover:text-primary mt-auto w-fit">
      {t('common.viewDetails')} →
    </a>
  </div>
</article>
