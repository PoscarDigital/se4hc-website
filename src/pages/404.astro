---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, getLocalizedPath } from '../utils/i18n';
const t = useTranslations('km');
---

<BaseLayout title={t('notFound.title')}>
  <section class="py-24 text-center">
    <div class="container">
      <p class="text-7xl font-bold text-secondary mb-4">404</p>
      <h1 class="text-2xl font-bold text-primary mb-3">{t('notFound.title')}</h1>
      <p class="text-gray-600 mb-8 max-w-md mx-auto">{t('notFound.message')}</p>
      <a href={getLocalizedPath('/', 'km')} class="btn btn-primary no-underline">{t('notFound.back')}</a>
    </div>
  </section>
</BaseLayout>
