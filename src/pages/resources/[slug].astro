---
import { getCollection, render } from 'astro:content';
import { inLang } from '../../utils/content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { useTranslations } from '../../utils/i18n';
import { formatDate, entrySlug } from '../../utils/helpers';
import { resolveAttachments } from '../../utils/attachments';
import FeatureImage from '../../components/media/FeatureImage.astro';
import AttachmentList from '../../components/media/AttachmentList.astro';

export async function getStaticPaths() {
  const resources = await getCollection('resources', inLang('km'));
  return resources.map((resource) => ({
    params: { slug: entrySlug(resource.id) },
    props: { resource },
  }));
}

const { resource } = Astro.props;
const { Content } = await render(resource);
const t = useTranslations('km');
const { title, type, date, featureImage, featureImageAlt } = resource.data;
const attachments = resolveAttachments(resource.data.attachments, import.meta.env.BASE_URL);

const formatHint = [...new Set(attachments.map((a) => a.ext).filter(Boolean))].join(', ');
const metaParts = [
  type,
  date && `${t('common.updated')}: ${formatDate(date, 'km')}`,
  formatHint || undefined,
].filter(Boolean) as string[];
---

<ContentLayout
  title={title}
  meta={metaParts.join(' · ')}
  description={resource.data.excerpt}
  breadcrumbs={[{ label: t('nav.resources'), href: '/resources' }, { label: title }]}
>
  {featureImage && <FeatureImage src={featureImage} alt={featureImageAlt ?? title} class="mb-8" />}
  <Content />
  {attachments.length > 0 && (
    <div class="mt-10 pt-8 border-t border-gray-200">
      <AttachmentList attachments={attachments} lang="km" heading={t('common.documents')} />
    </div>
  )}
</ContentLayout>
